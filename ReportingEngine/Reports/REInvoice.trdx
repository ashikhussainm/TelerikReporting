                        <Style TextAlign="Center" VerticalAlign="Middle">
                          <Font Name="Microsoft Sans Serif" />
                          <BorderColor Default="Gray" />
                          <Padding Left="3pt" Right="3pt" />
                        </Style>
                      </TextBox>
                    </ReportItem>
                  </TableCell>
                  <TableCell RowIndex="0" ColumnIndex="3" RowSpan="1" ColumnSpan="1">
