                <BorderStyle Default="Solid" />
                <BorderColor Default="Black" />
                <BorderWidth Default="0.5pt" />
              </Style>
              <Items>
                <TextBox Width="8cm" Height="0.687cm" Left="0.2cm" Top="0.1cm" Value="Customer Details" Name="textBox17" StyleName="BlueOpal.TableBody">
                  <Style BackgroundColor="15, 36, 62" Color="242, 242, 242" TextAlign="Center">
                    <Font Name="Microsoft Sans Serif" Size="14pt" Bold="True" Italic="False" />
                    <BorderStyle Default="Solid" Top="None" Left="None" Right="None" />
                    <BorderColor Default="Black" />
                    <BorderWidth Default="0.5pt" />
                  </Style>
                </TextBox>
                <TextBox Width="2.5cm" Height="0.6cm" Left="0.2cm" Top="1cm" Value="Name" Name="lblKupac">
                  <Style>
                    <Font Name="Microsoft Sans Serif" Size="9pt" Bold="True" />
                  </Style>
                </TextBox>
                <TextBox Width="2.5cm" Height="0.6cm" Left="0.2cm" Top="2.4cm" Value="Address" Name="textBox32">
                  <Style>
                    <Font Name="Microsoft Sans Serif" Size="9pt" Bold="True" />
                  </Style>
                </TextBox>
                <TextBox Width="5.2cm" Height="0.6cm" Left="2.8cm" Top="1.006cm" Value="=Fields.CustomerName" Name="textBox18">
                  <Style>
                    <Font Name="Microsoft Sans Serif" Size="9pt" />
                  </Style>
                </TextBox>
                <TextBox Width="5.2cm" Height="0.6cm" Left="2.8cm" Top="1.706cm" Value="=Fields.CustomerNumber" Name="textBox19">
                  <Style>
                    <Font Name="Microsoft Sans Serif" Size="9pt" />
                  </Style>
