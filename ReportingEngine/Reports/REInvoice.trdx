                <TextBox Width="2.5cm" Height="0.6cm" Left="0.2cm" Top="1.706cm" Value="Customer ID" Name="textBox4">
                  <Style>
                    <Font Name="Microsoft Sans Serif" Size="9pt" Bold="True" />
                  </Style>
                </TextBox>
              </Items>
            </Panel>
            <Table DataSourceName="invoiceDataSource" Width="18.3cm" Height="1.661cm" Left="0.3cm" Top="4.6cm" Name="table1" StyleName="BlueOpal.TableNormal">
              <Body>
                <Cells>
                  <TableCell RowIndex="0" ColumnIndex="0" RowSpan="1" ColumnSpan="1">
                    <ReportItem>
                      <TextBox Width="1.537cm" Height="0.619cm" Left="0cm" Top="0cm" Value="=RowNumber()" Name="textBox14" StyleName="BlueOpal.TableBody">
                        <Style TextAlign="Center" VerticalAlign="Middle">
                          <Font Name="Microsoft Sans Serif" />
                          <BorderColor Default="Gray" />
                          <Padding Left="3pt" Right="3pt" />
                        </Style>
