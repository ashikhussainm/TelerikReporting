<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="invoiceDataSource" Width="20.2cm" Name="MneInvoiceDataSource" ShowSnapGrid="True" xmlns="http://schemas.telerik.com/reporting/2025/1.0">
  <DataSources>
    <ObjectDataSource ParameterValues="{}" DataMember="GetReportData" Name="invoiceDataSource">
      <DataSource>
        <String>ReportingEngine.Services.InvoiceService, ReportingEngine, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null</String>
      </DataSource>
      <Parameters>
        <ObjectDataSourceParameter Name="invoiceNumber">
          <DataType>System.String</DataType>
          <Value>
            <String>=Parameters.InvoiceNumber.Value</String>
          </Value>
        </ObjectDataSourceParameter>
      </Parameters>
    </ObjectDataSource>
  </DataSources>
  <Items>
    <PageHeaderSection Height="3.2cm" Name="pageHeaderSection1">
      <Items>
        <PictureBox Image="" Width="5.2cm" Height="2.6cm" Left="0.1cm" Top="0cm" Sizing="ScaleProportional" MimeType="" Name="pictureBox1" />
        <TextBox Width="9.939cm" Height="0.7cm" Left="5.6cm" Top="0.4cm" Value="Report Engine - Sample Invoice" Name="textBox23">
          <Style>
            <Font Name="Microsoft Sans Serif" Size="14pt" Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="9.939cm" Height="1.4cm" Left="5.6cm" Top="1.1cm" Value="Engine Room, Building 8/6,&#xD;&#xA;Bengaluru, Karnataka, India&#xD;&#xA;PAN : ABCDE1234F" Name="textBox15">
          <Style>
            <Font Name="Microsoft Sans Serif" Size="10pt" />
          </Style>
        </TextBox>
      </Items>
    </PageHeaderSection>
    <DetailSection Height="0.132cm" Name="detailSection1" />
    <PageFooterSection Height="0.4cm" Name="pageFooterSection1">
      <Style>
        <Font Size="6pt" />
      </Style>
      <Items>
        <TextBox Width="8.7cm" Height="0.3cm" Left="0.3cm" Top="0cm" Value="www.reportengine.sample" Name="textBox41">
          <Style>
            <BorderStyle Bottom="Solid" />
            <BorderColor Default="Gray" />
            <BorderWidth Default="0.5pt" />
          </Style>
        </TextBox>
        <TextBox Width="9.9cm" Height="0.3cm" Left="9cm" Top="0cm" Value="https://medium.com/@ashikmhussain.a" Name="textBox42">
          <Style TextAlign="Right">
            <Font Name="Microsoft Sans Serif" />
            <BorderStyle Bottom="Solid" />
            <BorderColor Default="Gray" />
            <BorderWidth Default="0.5pt" />
          </Style>
        </TextBox>
      </Items>
    </PageFooterSection>
  </Items>
  <PageSettings PaperKind="A4" Landscape="False" ContinuousPaper="False">
    <Margins>
      <MarginsU Left="1cm" Right="1cm" Top="1cm" Bottom="1cm" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
      <Style>
        <Padding Left="2pt" Right="2pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
        <TypeSelector Type="HtmlTextBox" />
      </Selectors>
    </StyleRule>
    <StyleRule>
      <Style Color="0, 63, 89">
        <Font Name="Segoe UI" Size="9pt" />
        <BorderStyle Default="Solid" />
        <BorderColor Default="187, 220, 235" />
        <BorderWidth Default="1px" />
      </Style>
      <Selectors>
        <StyleSelector Type="Table" StyleName="BlueOpal.TableNormal" />
      </Selectors>
    </StyleRule>
    <StyleRule>
      <Style Color="0, 63, 89">
        <Font Name="Segoe UI" Size="9pt" />
        <BorderStyle Default="Solid" />
        <BorderColor Default="187, 220, 235" />
        <BorderWidth Default="1px" />
      </Style>
      <Selectors>
        <DescendantSelector>
          <Selectors>
            <TypeSelector Type="Table" />
            <StyleSelector Type="ReportItem" StyleName="BlueOpal.TableBody" />
          </Selectors>
        </DescendantSelector>
      </Selectors>
    </StyleRule>
    <StyleRule>
      <Style BackgroundColor="233, 244, 249" Color="0, 63, 89" VerticalAlign="Middle">
        <Font Name="Segoe UI" Size="10pt" />
        <BorderStyle Default="Solid" />
        <BorderColor Default="187, 220, 235" />
        <BorderWidth Default="1px" />
      </Style>
      <Selectors>
        <DescendantSelector>
          <Selectors>
            <TypeSelector Type="Table" />
            <StyleSelector Type="ReportItem" StyleName="BlueOpal.TableHeader" />
          </Selectors>
        </DescendantSelector>
      </Selectors>
    </StyleRule>
  </StyleSheet>
  <Groups>
    <Group Name="group2">
      <GroupHeader>
        <GroupHeaderSection PrintOnEveryPage="False" Height="6.5cm" Name="groupHeaderSection1">
          <Style Visible="True" />
          <Items>
            <Panel Width="8.3cm" Height="3.5cm" Left="1cm" Top="0.2cm" Name="panel1">
              <Style>
                <BorderStyle Default="Solid" />
                <BorderColor Default="Black" />
                <BorderWidth Default="0.5pt" />
              </Style>
              <Items>
                <TextBox Width="8cm" Height="0.687cm" Left="0.161cm" Top="0.111cm" Value="Invoice Details" Name="txtRacun" StyleName="BlueOpal.TableBody">
                  <Style BackgroundColor="15, 36, 62" Color="242, 242, 242" TextAlign="Center">
                    <Font Name="Microsoft Sans Serif" Size="14pt" Bold="True" />
                    <BorderStyle Default="Solid" Top="None" Left="None" Right="None" />
                    <BorderColor Default="Black" />
                    <BorderWidth Default="0.5pt" />
                  </Style>
                </TextBox>
                <TextBox Width="2.666cm" Height="0.6cm" Left="0.161cm" Top="1cm" Value="Date Of Invoice" Name="textBox36">
                  <Style Color="0, 32, 96">
                    <Font Name="Microsoft Sans Serif" Size="9pt" Bold="True" />
                  </Style>
                </TextBox>
                <TextBox Width="2.666cm" Height="0.6cm" Left="0.161cm" Top="1.7cm" Value="Due Date" Name="textBox34">
                  <Style>
                    <Font Name="Microsoft Sans Serif" Size="9pt" Bold="True" />
                  </Style>
                </TextBox>
                <TextBox Width="2.666cm" Height="0.6cm" Left="0.161cm" Top="2.4cm" Value="Invoice Number" Name="textBox33">
                  <Style>
                    <Font Name="Microsoft Sans Serif" Size="9pt" Bold="True" />
                  </Style>
                </TextBox>
                <TextBox Width="5.1cm" Height="0.6cm" Left="3cm" Top="1.006cm" Value="=Fields.Date" Format="{0:dddd, MMMM dd yyyy}" Name="textBox7">
                  <Style>
                    <Font Name="Microsoft Sans Serif" Size="9pt" />
                  </Style>
                </TextBox>
                <TextBox Width="5.1cm" Height="0.6cm" Left="3cm" Top="1.7cm" Value="=Fields.DueDate" Format="{0:dddd, MMMM dd yyyy}" Name="textBox22">
                  <Style>
                    <Font Name="Microsoft Sans Serif" Size="9pt" />
                  </Style>
                </TextBox>
                <TextBox Width="5.1cm" Height="0.6cm" Left="3cm" Top="2.406cm" Value="=Parameters.InvoiceNumber.Value" Name="textBox10">
                  <Style>
                    <Font Name="Microsoft Sans Serif" Size="9pt" />
                  </Style>
                </TextBox>
              </Items>
            </Panel>
            <Panel Width="8.3cm" Height="3.5cm" Left="10cm" Top="0.2cm" Name="panKupac">
